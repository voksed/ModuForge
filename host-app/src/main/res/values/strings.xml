    <string name="settings_offline_title">Works offline</string>
    <string name="settings_offline_body">The host connects to the network only for modules you granted internet access, recording each connection in the audit log, and to GitHub when you check for an update or open an install link.</string>
    <string name="settings_responsible_title">Responsible use</string>
    <string name="settings_responsible_body">ModuForge is for authorized testing, learning and automation. Use modules only against systems you own or are explicitly permitted to test. Intrusive permissions require confirming authorization for each target, and every such confirmation is recorded in the audit log.</string>

    <string name="cap_network_outbound">Internet access</string>
    <string name="cap_network_outbound_desc">Open connections to servers on the internet. The module can send anything it has access to and download content.</string>
    <string name="cap_file_sandboxed">Private storage</string>
    <string name="cap_file_sandboxed_desc">Read and write files in the module\'s own isolated folder. Other modules and your files stay out of reach.</string>
    <string name="cap_file_shared">Shared files</string>
    <string name="cap_file_shared_desc">Read and write files and folders you pick outside the module\'s own storage. These may hold personal data.</string>
    <string name="cap_clipboard">Clipboard</string>
    <string name="cap_clipboard_desc">Read and replace clipboard contents. The clipboard often holds passwords and other secrets.</string>
    <string name="cap_notifications">Notifications</string>
    <string name="cap_notifications_desc">Show notifications in the module\'s name.</string>
    <string name="cap_background_execution">Run in background</string>
    <string name="cap_background_execution_desc">Keep working while ModuForge is not on screen. This uses battery and the module acts without you watching.</string>
    <string name="cap_ai_inference">AI models</string>
    <string name="cap_ai_inference_desc">Send prompts to the AI models you configured. With a cloud provider the prompts leave the device and may be billed to your API key.</string>
    <string name="cap_bot_gateway">Bot hosting</string>
    <string name="cap_bot_gateway_desc">Run a long-lived bot using credentials stored by the host. The bot acts under that account.</string>
    <string name="cap_device_info">Device information</string>
    <string name="cap_device_info_desc">Read the device model, OS version and similar details that can identify this device.</string>
    <string name="cap_local_network_scan">Local network scan</string>
    <string name="cap_local_network_scan_desc">Probe hosts on the local network. Allowed only for targets you confirm you are authorized to test.</string>
